# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=fastRepair_bd

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# OTP
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=3

# SMS Provider (mock | twilio | orange)
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SENDER_ID=RepairFone

# Firebase (for Phone Authentication)
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# CORS
ALLOWED_ORIGINS=http://localhost:4200

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ==============================================
# Monitoring — Sentry / GlitchTip (compatible)
# ==============================================
# Laisser vide pour désactiver. Format : https://xxx@xxx.ingest.sentry.io/yyy
SENTRY_DSN=
# Optionnel : tag de release pour corréler erreurs et déploiements
APP_VERSION=

# ==============================================
# Web Push (VAPID, W3C standard — pas Firebase)
# ==============================================
# Génération : node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# Si vide, les notifications push sont désactivées (notifs DB toujours créées).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@repairfone.ci

# ==============================================
# Email — Resend recommended (free tier 3k/mois, 100/jour)
# ==============================================
# Providers supportés : mock | smtp | sendgrid | resend
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@repairfone.ci
APP_NAME=RepairFone

# Resend — créer un compte sur https://resend.com puis générer une clé API
# Domaine 'onboarding@resend.dev' utilisable pour tester sans vérifier de domaine
RESEND_API_KEY=

# SendGrid (alternative, free tier 100/jour)
SENDGRID_API_KEY=

# SMTP générique (Gmail, Outlook, Brevo...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==============================================
# Paiement — Mobile Money Côte d'Ivoire
# ==============================================
# Providers : mock | cinetpay | paydunya
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=XOF
PAYMENT_RETURN_URL=http://localhost:4200/payments/callback
PAYMENT_NOTIFY_URL=http://localhost:3000/api/v1/payments/webhook

# CinetPay (https://cinetpay.com — créer un compte marchand)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# PayDunya (https://paydunya.com — sandbox immédiat, gratuit en test)
# Mode 'test' = sandbox (aucune commission, paiements simulés)
# Mode 'live' = production (commission ~3%)
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
